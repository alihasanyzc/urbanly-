# --- Urbanly API ortam değişkenleri ---
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.
# .env ASLA commit edilmez (bkz. CLAUDE.md §5.1).

# Çalışma ortamı: development | test | production
NODE_ENV=development

# API portu
PORT=4000

# Frontend origin(leri) — CORS beyaz listesi (virgülle ayrılır)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# PostgreSQL (PostGIS uzantılı) bağlantısı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanly?schema=public

# JWT sırları — güçlü rastgele değerler kullanın (ör. openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
